<!doctype html>
<!--
  Not-found page for fs.0x29a.me. Nginx answers every missing file and
  directory with this page and status 404 (`error_page` in
  sites-available/fs.0x29a.me.conf), at the URL that was asked for. The page
  walks up that URL to the nearest directory with a listing, links it, and
  suggests entries there with a similar name. Without JavaScript it still
  explains the error and links the root. It uses no template variables; the
  nginx role renders it with the other viewer pages.
-->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Not found · fs.0x29a.me</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #fff; --fg: #1f2328; --muted: #656d76; --line: #d0d7de; --subtle: #f6f8fa;
      --accent: #0969da; --folder: #54aeff; --button: #0969da;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0d1117; --fg: #e6edf3; --muted: #8d96a0; --line: #30363d; --subtle: #161b22;
        --accent: #4493f8; --folder: #58a6ff; --button: #1f6feb;
      }
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.5 system-ui, sans-serif; }
    a { color: inherit; }
    header { display: flex; gap: 1rem; align-items: baseline; padding: .6rem 1rem; border-bottom: 1px solid var(--line); }
    .path { flex: 1; min-width: 0; overflow-wrap: anywhere; font-weight: 600; }
    .path a { text-decoration: none; }
    .path a:hover { text-decoration: underline; }
    /* Inline-block keeps the missing segment's strike-through off the separator. */
    .path > * + *::before { content: "/"; display: inline-block; margin: 0 .35rem; color: var(--muted); font-weight: 400; }
    .path [aria-current] { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1px; }
    main { max-width: 36rem; margin: 0 auto; padding: 3rem 1rem; }
    .code { margin: 0; color: var(--muted); font: 600 13px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .08em; }
    h1 { margin: .4rem 0 .5rem; font-size: 1.75rem; line-height: 1.2; }
    p { margin: 0 0 1rem; }
    code {
      padding: .1rem .35rem; overflow-wrap: anywhere; background: var(--subtle); border: 1px solid var(--line);
      border-radius: 6px; font: 13px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
    .button {
      display: inline-flex; gap: .4rem; align-items: center; max-width: 100%; padding: .4rem .8rem;
      text-decoration: none; background: var(--subtle); border: 1px solid var(--line); border-radius: 6px;
    }
    .button span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .button:hover { border-color: var(--muted); }
    .button.primary { color: #fff; background: var(--button); border-color: transparent; }
    .button.primary:hover { filter: brightness(1.1); }
    .button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .suggestions { margin-top: 2rem; }
    .suggestions h2 { margin: 0 0 .5rem; color: var(--muted); font-size: 13px; font-weight: 600; }
    ul { margin: 0; padding: 0; list-style: none; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
    li + li { border-top: 1px solid var(--line); }
    li a { display: flex; gap: .75rem; align-items: center; padding: .45rem .75rem; overflow-wrap: anywhere; text-decoration: none; }
    li a:hover, li a:focus-visible { background: var(--subtle); text-decoration: underline; outline: none; }
    svg { flex: none; width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    li svg { color: var(--muted); }
    li[data-kind="folder"] svg, .button:not(.primary) svg { color: var(--folder); }
    li[data-kind="folder"] svg { fill: currentColor; fill-opacity: .2; }
    @media (max-width: 40rem) {
      header { padding-inline: .75rem; }
      main { padding: 2rem .75rem; }
      h1 { font-size: 1.5rem; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="path" id="path" aria-label="Path"><a href="/">fs.0x29a.me</a></nav>
  </header>
  <main>
    <p class="code">404</p>
    <h1>Not found</h1>
    <p id="explanation">Nothing is shared at this address. The file may have been moved, renamed or deleted, or the link may be mistyped.</p>
    <p id="nearest-note" hidden></p>
    <div class="actions">
      <a class="button primary" id="nearest" href="/"><svg aria-hidden="true"><use href="#i-home"></use></svg><span>Browse all files</span></a>
      <a class="button" id="root" href="/" hidden><svg aria-hidden="true"><use href="#i-home"></use></svg><span>All files</span></a>
    </div>
    <section class="suggestions" id="suggestions" hidden>
      <h2>Did you mean</h2>
      <ul id="suggestion-list"></ul>
    </section>
  </main>

  <svg hidden>
    <symbol id="i-up" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M4 10.5L12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z"/></symbol>
    <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.2l2 2.5h8.8A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M6 3h8l5 5v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5"/></symbol>
  </svg>

  <script>
    "use strict";

    // At most this many similarly named entries are suggested.
    const SUGGESTION_LIMIT = 5;

    const path = location.pathname;
    const segments = path.split("/").filter(Boolean);
    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: "base" });

    // File names need not be UTF-8; show such a path still percent-encoded.
    function decode(component) {
      try {
        return decodeURIComponent(component);
      } catch {
        return component;
      }
    }

    function directoryUrl(depth) {
      return "/" + segments.slice(0, depth).map((segment) => segment + "/").join("");
    }

    function displayPath(depth) {
      return "/" + segments.slice(0, depth).map((segment) => decode(segment) + "/").join("");
    }

    function renderPath() {
      const nav = document.getElementById("path");
      nav.firstElementChild.textContent = location.host;
      segments.forEach((segment, index) => {
        const last = index === segments.length - 1;
        const item = document.createElement(last ? "span" : "a");
        item.textContent = decode(segment);
        if (last) {
          item.setAttribute("aria-current", "page");
        } else {
          item.href = directoryUrl(index + 1);
        }
        nav.append(item);
      });
      const target = document.createElement("code");
      target.textContent = decode(path);
      document.getElementById("explanation").replaceChildren(
        "Nothing is shared at ", target,
        ". It may have been moved, renamed or deleted, or the link may be mistyped.");
    }

    // The nearest enclosing directory with a JSON listing, and its entries.
    // Missing directories answer with this page, protected ones redirect to a
    // sign-in, and directories without listings are refused; all are skipped.
    async function nearestListing() {
      for (let depth = segments.length - 1; depth >= 0; depth--) {
        try {
          const response = await fetch(directoryUrl(depth) + "?json", { redirect: "error" });
          if (response.ok) return { depth, entries: await response.json() };
        } catch {
          // Try the next directory up.
        }
      }
      return null;
    }

    function editDistance(a, b) {
      let previous = Array.from({ length: b.length + 1 }, (_, index) => index);
      for (let i = 1; i <= a.length; i++) {
        const current = [i];
        for (let j = 1; j <= b.length; j++) {
          current[j] = Math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
        }
        previous = current;
      }
      return previous[b.length];
    }

    function stem(name) {
      return name.includes(".", 1) ? name.slice(0, name.lastIndexOf(".")) : name;
    }

    // Case changes, a different extension and small typos all count as close.
    function similarity(wanted, name) {
      const a = wanted.toLowerCase();
      const b = name.toLowerCase();
      if (a === b) return 0;
      if (stem(a) === stem(b)) return 1;
      const distance = editDistance(a, b);
      return distance <= Math.max(2, Math.floor(Math.max(a.length, b.length) / 3)) ? distance + 1 : null;
    }

    function showSuggestions(depth, entries) {
      const wanted = decode(segments[depth]);
      const matches = entries
        .map((entry) => ({ entry, score: similarity(wanted, entry.name) }))
        .filter((match) => match.score !== null)
        .sort((a, b) => a.score - b.score || collator.compare(a.entry.name, b.entry.name))
        .slice(0, SUGGESTION_LIMIT);
      if (!matches.length) return;
      const list = document.getElementById("suggestion-list");
      for (const { entry } of matches) {
        const folder = entry.type === "directory";
        const item = document.createElement("li");
        item.dataset.kind = folder ? "folder" : "file";
        const link = document.createElement("a");
        link.href = directoryUrl(depth) + encodeURIComponent(entry.name) + (folder ? "/" : "");
        const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        icon.setAttribute("aria-hidden", "true");
        const use = document.createElementNS("http://www.w3.org/2000/svg", "use");
        use.setAttribute("href", folder ? "#i-folder" : "#i-file");
        icon.append(use);
        link.append(icon, entry.name + (folder ? "/" : ""));
        item.append(link);
        list.append(item);
      }
      document.getElementById("suggestions").hidden = false;
    }

    async function main() {
      renderPath();
      const listing = await nearestListing();
      if (!listing) return;
      if (listing.depth) {
        const nearest = document.getElementById("nearest");
        nearest.href = directoryUrl(listing.depth);
        nearest.querySelector("use").setAttribute("href", "#i-up");
        nearest.querySelector("span").textContent = "Open " + displayPath(listing.depth);
        document.getElementById("root").hidden = false;
      }
      if (listing.depth < segments.length - 1) {
        const missing = document.createElement("code");
        missing.textContent = displayPath(listing.depth + 1);
        const note = document.getElementById("nearest-note");
        note.replaceChildren("The folder ", missing, " does not exist either.");
        note.hidden = false;
      }
      showSuggestions(listing.depth, listing.entries);
    }

    main();
  </script>
</body>
</html>
